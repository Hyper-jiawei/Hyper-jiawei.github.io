---
import { site } from "../site.config";
import icons from "../data/icons.json";
import Wordmark from "./Wordmark.astro";
import BlogLink from "./BlogLink.astro";
import { defaultLang, homePath, langName, langTag, localeSwitch, locales, t, type Lang } from "../i18n";

type IconName = keyof typeof icons;

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const tr = t(lang);
const path = decodeURI(Astro.url.pathname);
---

<footer class="site-footer" transition:persist="site-footer">
  <div class="wrap">
    <a href={homePath(lang)} class="colophon" aria-label={tr.footer.home}><Wordmark size="clamp(30px, 5.5vw, 84px)" /></a>
    <div class="grid">
      <div class="about">
        <a href={site.aboutUrl} target="_blank" rel="noopener" class="avatar-link" aria-label={tr.footer.about}>
          <span class="avatar-frame"><img src={site.avatar} alt="" width="52" height="52" loading="lazy" class="avatar" /></span>
        </a>
        <div>
          <p class="name">{site.author}</p>
          <p class="bio">{tr.meta.bio}</p>
        </div>
      </div>

      <div class="col">
        <p class="label">{tr.footer.friends}</p>
        <ul>
          {
            site.friends.map((f) => (
              <li>
                <a href={f.url} target="_blank" rel="noopener" class="draw">
                  {f.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="col">
        <p class="label">{tr.footer.elsewhere}</p>
        <BlogLink class="footer-blog" lang={lang} />
        <ul class="social">
          {
            site.social.map((s) => {
              const icon = icons[s.icon as IconName];
              return (
                <li>
                  <a href={s.url} target={s.url.startsWith("mailto:") ? undefined : "_blank"} rel="noopener" title={s.label} aria-label={s.label}>
                    <svg viewBox={icon.viewBox} width="20" height="20" fill="currentColor" fill-rule={"fillRule" in icon ? icon.fillRule : undefined} aria-hidden="true">
                      {icon.paths.map((d) => (
                        <path d={d} />
                      ))}
                    </svg>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
    <div class="bottom">
      <span>{site.copyright}</span>
      {/* A plain link, not a router swap: another language is another document, with its own
          fonts and its own <html lang>. The hrefs are kept current by client.ts, since the
          footer is carried across navigations. */}
      <nav class="langs" aria-label={tr.footer.language} data-lang-switch>
        {
          locales.map((l) => (
            <a
              href={localeSwitch(path, l)}
              hreflang={langTag[l]}
              lang={langTag[l]}
              data-lang={l}
              data-astro-reload
              aria-current={l === lang ? "page" : undefined}
              class:list={["lang", { "is-current": l === lang }]}
            >
              {langName[l]}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(120px, 16vw, 260px);
    padding-bottom: 32px;
    color: var(--fg-muted);
    font-size: 14px;
  }
  .colophon {
    display: block;
    width: max-content;
    max-width: 100%;
    margin: 0 0 clamp(48px, 6vw, 96px);
    color: var(--fg);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
    padding-top: 40px;
    border-top: 1px solid var(--line);
  }
  .about {
    display: flex;
    gap: 18px;
    align-items: flex-start;
    max-width: 420px;
  }
  /* The avatar file is already a round cut-out; it is shown as it is. */
  .avatar-frame {
    position: relative;
    display: block;
    width: 52px;
    height: 52px;
    transition: transform 0.8s var(--ease-out);
  }
  .avatar {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* The headwear rides with the photo when it tilts. */
  .avatar-link:hover .avatar-frame {
    transform: rotate(-8deg);
  }
  /* The day's headwear (seasonal, or a festival's hat), added by script. */
  .avatar-frame :global(.avatar-wear) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    transform-origin: 80% 15%;
    animation: wear-on 0.9s var(--ease-out) both;
  }
  @keyframes wear-on {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.7) rotate(12deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .avatar-frame :global(.avatar-wear) {
      animation: none;
    }
  }
  .name {
    margin: 0 0 4px;
    font: 800 20px/1.2 var(--font-cn);
    line-height: 1.2;
    color: var(--fg);
  }
  .bio {
    margin: 0;
  }
  .col .label {
    margin: 4px 0 16px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .col a:hover {
    color: var(--fg);
  }
  /* Full-size sign (2px LED cells, as in the header) so it holds its own beside the icons. */
  .col :global(.footer-blog) {
    --led-h: 16px;
    --led-arrow: 14px;
    display: flex;
    width: max-content;
    height: 24px;
    padding: 0;
    margin: 0 0 14px;
  }
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .social a {
    display: block;
    transition:
      color 0.3s,
      transform 0.4s var(--ease-out);
  }
  .social a:hover {
    color: var(--accent);
    transform: translateY(-2px);
  }
  .bottom {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 10px clamp(18px, 3vw, 36px);
    margin-top: 56px;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--fg-faint);
  }
  .bottom a:hover {
    color: var(--fg);
  }
  /* The language switch: three names, the current one at full ink. */
  .langs {
    display: flex;
    align-items: center;
    gap: clamp(12px, 1.6vw, 20px);
    padding-left: clamp(18px, 3vw, 36px);
    border-left: 1px solid var(--line);
  }
  .lang {
    font-family: var(--font-sans);
    font-size: 11.5px;
    letter-spacing: 0.02em;
    opacity: 0.55;
    transition: opacity 0.3s, color 0.3s;
  }
  .lang:hover,
  .lang.is-current {
    opacity: 1;
  }
  .lang.is-current {
    color: var(--fg);
  }
  /* A hairline between the names, like the dots in the small mono lines. */
  .lang + .lang {
    position: relative;
  }
  .lang + .lang::before {
    content: "";
    position: absolute;
    left: calc(-1 * clamp(6px, 0.8vw, 10px));
    top: 50%;
    width: 1px;
    height: 10px;
    transform: translateY(-50%);
    background: var(--line);
  }
  @media (max-width: 800px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .about {
      grid-column: 1 / -1;
    }
  }
</style>
