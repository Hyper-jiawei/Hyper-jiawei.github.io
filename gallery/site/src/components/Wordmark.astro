---
// "Hyper’s GALLERY", drawn from outlines generated by scripts/build-wordmark.mjs
// (Newsreader 800 + Unbounded 200 small caps), so its spacing and alignment never
// depend on font loading. Hover: the apostrophe floats up and GALLERY opens out.
import mark from "../data/wordmark.json";
import { markHit, markMarkup } from "../lib/festive";

interface Props {
  size?: string;
  class?: string;
  /** Festive marks drawn in place of the apostrophe (the hidden gallery shows them all). */
  marks?: { name: string; place: string; svg: string }[];
}
const { size = "28px", class: className, marks } = Astro.props;
const h = mark.bottom - mark.top;
---

<span class:list={["wm", className]} style={`--wm:${size};--step:${mark.subStep}px`}>
  <svg
    viewBox={`0 ${mark.top} ${mark.width} ${h}`}
    style={`height:calc(var(--wm) * ${(h / 1000).toFixed(4)});aspect-ratio:${mark.width}/${h}`}
    role="img"
    aria-label="Hyper's Gallery"
  >
    <g class="wm-main">{mark.main.map((d) => <path d={d} />)}</g>
    {marks ? (
      <Fragment set:html={marks.map((m, i) => markMarkup(m.name, m.place, m.svg, ` data-mark="${i}"`)).join("") + markHit(marks[0].place)} />
    ) : (
      <path class="wm-tick" d={mark.tick} />
    )}
    <g class="wm-sub">{mark.sub.map((d, i) => <path d={d} style={`--i:${i}`} />)}</g>
  </svg>
</span>

<style>
  .wm {
    display: inline-block;
    line-height: 0;
    vertical-align: middle;
  }
  svg {
    display: block;
    width: auto;
    overflow: visible;
    fill: currentColor;
  }
  .wm-tick {
    fill: var(--accent);
    transition: transform 0.7s var(--ease-out);
  }
  .wm-sub path {
    transition: transform 0.9s var(--ease-out);
  }
  /* Festive marks are injected markup, so their rules cannot be scoped. */
  .wm :global(.wm-mark) {
    transition: transform 0.7s var(--ease-out);
  }
  .wm :global(.wm-mark-pop) {
    transform-box: fill-box;
    transform-origin: center;
  }
  /* 1000 units = 1em of the mark, so these px values are in the mark's own units.
     .is-lifted holds the hover pose where there is no hover (a tap in the hidden gallery). */
  .wm:hover .wm-tick,
  .wm.is-lifted .wm-tick,
  .wm:hover :global(.wm-mark),
  .wm.is-lifted :global(.wm-mark) {
    transform: translateY(-200px);
  }
  .wm:hover .wm-sub path,
  .wm.is-lifted .wm-sub path {
    transform: translateX(calc(var(--i) * var(--step)));
  }
</style>
