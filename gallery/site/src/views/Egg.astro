---
// Hidden page (not linked anywhere, not indexed): every festive mark that can take
// the apostrophe's place in the wordmark, one at a time, with ← / → to browse.
import Base from "../layouts/Base.astro";
import Wordmark from "../components/Wordmark.astro";
import data from "../data/festive-marks.json";
import { defaultLang, markName, markWhen, t, type Lang } from "../i18n";

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const tr = t(lang);
const KIND = tr.egg.kinds;
const marks = data.marks.map((m) => ({ name: m.name, place: data.place, svg: m.svg }));
const total = String(data.marks.length).padStart(2, "0");
// Digits the counter has to fit, so the ← / → buttons never shift as the number changes.
const digits = String(data.marks.length).length;
const first = data.marks[0];
---

<Base title={tr.egg.title} description={tr.egg.description} noindex lang={lang}>
  <section class="egg wrap" data-festive-gallery>
    <p class="eyebrow">{tr.egg.eyebrow} · <span class="label-cn">{tr.egg.title}</span></p>
    <div class="stage" data-egg-stage>
      <div class="mark"><Wordmark size="var(--egg-size)" marks={marks} /></div>
    </div>
    <div class="caption" aria-live="polite">
      <h1 class="name cn-title" data-egg-name>{markName(first.name, lang)}</h1>
      <p class="meta"><span data-egg-kind>{KIND[first.kind]}</span><span aria-hidden="true">·</span><span data-egg-when>{markWhen(first.when, lang)}</span></p>
      <div class="stepper" style={`--digits: ${digits}`}>
        <button class="step" type="button" data-egg-step="-1" aria-label={tr.egg.prev} title={`${tr.egg.prev} (←)`} aria-keyshortcuts="ArrowLeft">
          <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M16 10H4M9 5l-5 5 5 5" stroke-linecap="square" /></svg>
        </button>
        <p class="counter"><span class="current" data-egg-index>01</span><span class="total num">/ {total}</span></p>
        <button class="step" type="button" data-egg-step="1" aria-label={tr.egg.next} title={`${tr.egg.next} (→)`} aria-keyshortcuts="ArrowRight">
          <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" stroke-linecap="square" /></svg>
        </button>
      </div>
    </div>
    <nav class="index" aria-label={tr.egg.all}>
      <span class="label">Index</span>
      <ol class="thumbs">
        {data.marks.map((m, i) => (
          <li>
            <button
              type="button"
              data-egg-thumb={i}
              data-name={m.name}
              data-label={markName(m.name, lang)}
              data-kind={KIND[m.kind]}
              data-when={markWhen(m.when, lang)}
              aria-label={markName(m.name, lang)}
              title={markName(m.name, lang)}
            >
              <svg viewBox="-4 -4 108 108" aria-hidden="true" set:html={m.svg} />
            </button>
          </li>
        ))}
      </ol>
    </nav>
  </section>
</Base>

<style>
  .egg {
    --egg-size: clamp(48px, 10vw, 168px);
    min-height: 100svh;
    padding-top: calc(var(--header-h) + clamp(48px, 9vh, 120px));
    padding-bottom: clamp(64px, 9vw, 140px);
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 26px;
    text-align: center;
  }
  /* The same small mono line as the home page's "Featured · 精选". */
  .eyebrow,
  .meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 300;
    font-stretch: 87.5%;
    letter-spacing: 0.08em;
    line-height: 1.7;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .label-cn {
    font-weight: 400;
  }
  .stage {
    width: 100%;
    /* Room above for the mark to float into on hover. */
    padding-top: calc(var(--egg-size) * 0.3);
    touch-action: pan-y;
  }
  .mark {
    display: flex;
    justify-content: center;
  }
  /* Square hairline buttons, like 返回: they fill in on hover. */
  .step {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--line);
    background: none;
    color: var(--fg);
    cursor: pointer;
    transition:
      background-color 0.3s,
      color 0.3s,
      border-color 0.3s;
  }
  .step svg {
    transition: transform 0.5s var(--ease-out);
  }
  .step:hover {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }
  .step:first-child:hover svg {
    transform: translateX(-3px);
  }
  .step:last-child:hover svg {
    transform: translateX(3px);
  }
  .caption {
    display: grid;
    justify-items: center;
    gap: 6px;
    margin-top: 14px;
  }
  .caption p {
    margin: 0;
  }
  .name {
    margin: 0;
    font-size: clamp(28px, 3.6vw, 44px);
  }
  .meta {
    display: flex;
    gap: 10px;
  }
  .meta span:first-child {
    color: var(--accent);
  }
  /* Counter with the ← / → buttons flanking it. */
  .stepper {
    display: grid;
    grid-template-columns: auto auto auto;
    align-items: center;
    gap: clamp(14px, 2vw, 22px);
    margin-top: 12px;
  }
  /* Like the home page's slide counter: the current number in heavy Song. */
  .counter {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 10px;
    margin: 0 !important;
  }
  .current {
    /* Fixed slot + tabular digits: the buttons never move as the number changes. */
    min-width: calc(var(--digits, 2) * 1ch);
    font: 900 22px/1 var(--font-cn);
    font-variant-numeric: tabular-nums;
    text-align: center;
    color: var(--fg);
  }
  .total {
    font-size: 13px;
    color: var(--fg-faint);
  }
  /* The index: one band between hairlines, like the home page's category filters. */
  .index {
    width: min(100%, 880px);
    margin-top: 18px;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 16px clamp(20px, 2.6vw, 40px);
    padding-block: 16px;
    border-block: 1px solid var(--line);
    text-align: left;
  }
  .index .label {
    padding-top: 14px;
    color: var(--fg-faint);
  }
  .thumbs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(44px, 1fr));
    gap: 4px;
  }
  .thumbs button {
    width: 100%;
    aspect-ratio: 1;
    padding: 8px 8px 10px;
    border: 0;
    background: none;
    cursor: pointer;
    /* The selected one is underlined, the way the site marks a current link. */
    background-image: linear-gradient(var(--fg), var(--fg));
    background-repeat: no-repeat;
    background-position: center 100%;
    background-size: 0 1px;
    transition: background-size 0.6s var(--ease-out);
  }
  .thumbs svg {
    display: block;
    width: 100%;
    height: 100%;
    transition: transform 0.5s var(--ease-out);
  }
  .thumbs button:hover svg {
    transform: translateY(-3px);
  }
  .thumbs button:hover,
  .thumbs button[aria-current="true"] {
    background-size: 60% 1px;
  }

  /* Switching: the outgoing mark slides out one way, the new one comes in from the other. */
  .mark :global(.wm-mark:not(.is-on)) {
    pointer-events: none;
  }
  .mark :global(.wm-mark-hit) {
    cursor: pointer;
  }
  .mark :global(.wm-mark-slot) {
    opacity: 0;
    transform: translateX(calc(var(--dir, 1) * 160px));
    transition:
      transform 0.7s var(--ease-out),
      opacity 0.45s var(--ease);
  }
  .mark :global(.wm-mark.is-on .wm-mark-slot) {
    opacity: 1;
    transform: none;
  }
  .mark :global(.wm-mark.was-on .wm-mark-slot) {
    transform: translateX(calc(var(--dir, 1) * -160px));
  }
  .mark :global(.wm-mark.no-anim .wm-mark-slot) {
    transition: none;
  }

  @media (max-width: 640px) {
    .egg {
      --egg-size: 11vw;
    }
    .stepper {
      gap: 12px;
    }
    .step {
      width: 32px;
      height: 32px;
    }
    .index {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .index .label {
      padding-top: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mark :global(.wm-mark-slot) {
      transition: opacity 0.3s linear;
      transform: none;
    }
  }
</style>
