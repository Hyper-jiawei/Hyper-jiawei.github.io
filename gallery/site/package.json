{
  "name": "hypers-gallery",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "images": "node scripts/build-images.mjs && node scripts/prefix-gallery.mjs",
    "dev": "npm run images && astro dev",
    "build": "node scripts/build-images.mjs && node scripts/prefix-gallery.mjs && astro build && node scripts/nested-404.mjs",
    "preview": "astro preview",
    "wordmark": "node scripts/build-wordmark.mjs",
    "favicon": "node scripts/build-favicon.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/commissioner": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.2.7",
    "@fontsource-variable/newsreader": "^5.2.8",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@fontsource-variable/noto-sans-sc": "^5.2.10",
    "@fontsource-variable/noto-serif-jp": "^5.3.1",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "astro": "7.3.5",
    "photoswipe": "^5.4.4"
  },
  "devDependencies": {
    "exifr": "^7.1.3",
    "fontkit": "^2.0.4",
    "heic-decode": "^2.1.0",
    "js-yaml": "^5.4.3",
    "sharp": "^0.34.5",
    "subset-font": "^2.9.0",
    "wawoff2": "^2.0.1"
  }
